<Window x:Class="LatexDesktopCustom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LatexDesktopCustom"
        xmlns:pdfviewer="clr-namespace:LatexDesktopCustom.PdfViewer"
        mc:Ignorable="d"
        Title="MainWindow" Icon="Assets/app-icon.ico" WindowStartupLocation="Manual"
        Background="#FFFF00FF">
    <Grid x:Name="LayoutRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="150" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" MinWidth="150" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="TerminalPanel" Grid.Column="0">
            <TextBlock x:Name="TerminalStatus" Text="Abriendo Windows PowerShell…" Foreground="White" TextWrapping="Wrap" Margin="16" VerticalAlignment="Center" />
        </Grid>

        <GridSplitter x:Name="PanelSplitter" Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#B0B0B0"
                      Cursor="SizeWE"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="False"
                      AutomationProperties.Name="Ajustar ancho de los paneles" />

        <Grid x:Name="PdfViewerPanel" Grid.Column="2" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="#F3F4F6" Padding="8">
                <StackPanel>
                  <WrapPanel>
                    <Button x:Name="OpenPdfButton" Content="Abrir PDF" Padding="12,6"
                            IsEnabled="False" Click="OpenPdf_Click" />
                    <Button x:Name="SelectMainFileButton" Content="Seleccionar .tex" Padding="12,6" Margin="6,0,0,0" Click="SelectMainFile_Click" />
                    <Button x:Name="CompileButton" Content="Compilar" Padding="12,6" Margin="6,0,0,0" IsEnabled="False" Click="Compile_Click" />
                    <Button x:Name="OpenCompileLogButton" Content="Ver log" Padding="12,6" Margin="6,0,0,0" Visibility="Collapsed" Click="OpenCompileLog_Click" />
                  </WrapPanel>
                    <TextBlock x:Name="MainFileLabel" Text="Selecciona el archivo principal .tex" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PdfFileName" Text="Ningún PDF abierto" Margin="0,4,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <pdfviewer:PdfWebViewControl x:Name="PdfWebView" Grid.Row="1"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           AutomationProperties.Name="Visor PDF" />
            <Border x:Name="PdfViewerStatusPanel" Grid.Row="1" Background="White" Padding="24">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PdfViewerStatus" Text="Iniciando visor PDF…"
                               TextWrapping="Wrap" Foreground="#374151" />
                    <Button x:Name="RetryPdfViewerButton" Content="Reintentar"
                            Visibility="Collapsed" HorizontalAlignment="Left"
                            Margin="0,12,0,0" Padding="12,6" Click="RetryPdfViewer_Click" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="CompilationStatus" Grid.Row="2" Margin="10,6" TextWrapping="Wrap" Foreground="#374151" />
        </Grid>
    </Grid>
</Window>
